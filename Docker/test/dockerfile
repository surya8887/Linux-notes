# 1️⃣ Use Node.js image
FROM node:24.4.1

# 2️⃣ Set working directory
WORKDIR /app

# 3️⃣ Copy package files first (for caching)
COPY package*.json ./

# 4️⃣ Install dependencies
RUN npm install

# 5️⃣ Copy the rest of the project
COPY . .

# 6️⃣ Expose Vite default port
EXPOSE 5173

# 7️⃣ Start Vite dev server
CMD ["npm", "run", "dev"]
